{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@vendor/web/*": ["./vendor/bitcoinpir-web/*"],
      "@vendor/wasm": ["./vendor/pir-sdk-wasm/pir_sdk_wasm.js"],
      "@vendor/wasm/*": ["./vendor/pir-sdk-wasm/*"],
      "pir-sdk-wasm": ["./vendor/pir-sdk-wasm/pir_sdk_wasm.js"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
