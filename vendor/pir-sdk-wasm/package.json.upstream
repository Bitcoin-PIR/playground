  },
  "files": [
    "pir_sdk_wasm_bg.wasm",
    "pir_sdk_wasm.js",
    "pir_sdk_wasm.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "main": "pir_sdk_wasm.js",
  "homepage": "https://github.com/Bitcoin-PIR/Bitcoin-PIR",
  "types": "pir_sdk_wasm.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "keywords": [
    "pir",
    "privacy",
    "bitcoin",
    "wasm",
    "webassembly"
  ]
}